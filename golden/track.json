        {"args": [[0, 0, 0], [1, 2, 3], [4, 0, -2], 0], "out": [1, 2, 3]},
        {"args": [[0, 0, 0], [1, 2, 3], [4, 0, -2], 0.5], "out": [2.5, 1, 0.5]},
        {"args": [[0, 0, 0], [1, 2, 3], [4, 0, -2], 1], "out": [4, 0, -2]},
        {"args": [[0, 0, 0], [1, 2, 3], [4, 0, -2], 1.5], "out": [5.5, -1, -4.5]}
